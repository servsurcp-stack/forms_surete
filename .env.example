# ─────────────────────────────────────────────────────────
#  SURETE FORM — Variables d'environnement
#  Copier ce fichier en .env.local pour le dev local
#  Ne JAMAIS committer .env.local dans Git
# ─────────────────────────────────────────────────────────

# URL de ton projet Supabase
# Dashboard Supabase → Settings → API → Project URL
SUPABASE_URL=https://VOTRE_PROJET.supabase.co

# Clé service_role (accès complet, côté serveur uniquement)
# Dashboard Supabase → Settings → API → service_role (secret)
# ⚠️  Ne jamais exposer cette clé dans le code frontend
SUPABASE_SERVICE_KEY=eyJ...

# Nom de la table cible
TABLE_NAME=db_verifications_chargement

# Origines autorisées (séparées par des virgules)
# En prod : ton domaine Vercel, ex: https://surete-form.vercel.app
# En dev  : http://localhost:3000
ALLOWED_ORIGINS=https://surete-form.vercel.app,http://localhost:3000
